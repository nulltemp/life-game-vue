# Cloudflare response headers (https://developers.cloudflare.com/pages/configuration/headers/)
# No CSP yet: it would have to allow the GA hosts (see #40).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

# Vite puts a content hash in these file names, so they can be cached for good
/assets/*
  Cache-Control: public, max-age=31536000, immutable
