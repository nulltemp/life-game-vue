{
  "name": "life-game-vue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check build-only",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "start-server-and-test \"vite preview --host 127.0.0.1 --port 4173 --strictPort\" http://127.0.0.1:4173 \"cypress run --e2e\"",
    "test:e2e:dev": "start-server-and-test \"vite dev --host 127.0.0.1 --port 4173 --strictPort\" http://127.0.0.1:4173 \"cypress open --e2e\"",
    "build-only": "vite build",
    "type-check": "run-p type-check:app type-check:config type-check:e2e",
    "type-check:app": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "type-check:config": "vue-tsc --noEmit -p tsconfig.config.json --composite false",
    "type-check:e2e": "vue-tsc --noEmit -p cypress/e2e/tsconfig.json",
    "lint": "eslint . --fix"
  },
  "dependencies": {
    "vue": "^3.5.46",
    "vuetify": "^4.3.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.9.1",
    "cypress": "^16.3.0",
    "eslint": "^10.8.1",
    "eslint-plugin-cypress": "^7.2.0",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^31.0.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "start-server-and-test": "^3.0.12",
    "typescript": "~7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.9"
  },
  "overrides": {
    "js-beautify": {
      "glob": "^14.0.6",
      "editorconfig": "^4.0.1"
    }
  }
}
